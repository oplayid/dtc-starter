# Masukkan Publishable API Key asli yang Anda buat di https://admin.oplay.id/app
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_masukkan_key_asli_anda_disini

# Ubah ke domain publik backend agar bisa diakses oleh browser
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://admin.oplay.id

# Default region code (biarkan atau sesuaikan)
NEXT_PUBLIC_DEFAULT_REGION=us

# Ubah ke domain publik storefront Anda
NEXT_PUBLIC_BASE_URL=https://store.oplay.id

# Stripe (kosongkan jika belum dipakai)
NEXT_PUBLIC_STRIPE_KEY=

# Node environment
NODE_ENV=production
